# CoinCall host client (Expo) — copy to `.env`
# Secrets stay on the API server only.
#
# Same live API as Luma User:
#   EXPO_PUBLIC_API_BASE_URL  ↔  NEXT_PUBLIC_API_BASE_URL
# Media (DPs / videos): Firebase Storage bucket below (not the database)

EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://coincall-api.onrender.com/api

EXPO_PUBLIC_EAS_PROJECT_ID=

# Agora App ID only (certificate is SERVER-ONLY on coincall-api)
EXPO_PUBLIC_AGORA_APP_ID=

# Firebase — Storage bucket holds host photos/videos
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
# Android FCM: absolute/relative path to the real google-services.json used by EAS/local builds.
GOOGLE_SERVICES_JSON=
EXPO_PUBLIC_FIREBASE_NATIVE_CONFIGURED=false

# API server — used to verify Firebase/Google ID tokens
FIREBASE_PROJECT_ID=lovecall-2291e

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
